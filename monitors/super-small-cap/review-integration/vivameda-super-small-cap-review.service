[Unit]
Description=Vivameda independent super-small-cap review and reviewed-only notification
After=network-online.target

[Service]
Type=oneshot
User=vivameda-scout
Group=vivameda-scout
WorkingDirectory=/opt/vivameda-super-small-cap-review
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 /opt/vivameda-super-small-cap-review/review_worker.py
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/vivameda-super-small-cap
TimeoutStartSec=150
MemoryMax=256M
CPUQuota=20%

